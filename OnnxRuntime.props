<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<ImportGroup Label="PropertySheets" />

	<PropertyGroup>
		<IncludePath>$(ProjectDir)onnxruntime\include;$(IncludePath)</IncludePath>
		<LibraryPath>$(ProjectDir)onnxruntime\lib;$(LibraryPath)</LibraryPath>
	</PropertyGroup>

	<ItemDefinitionGroup>
		<Link>
			<AdditionalDependencies>onnxruntime.lib;%(AdditionalDependencies)</AdditionalDependencies>
		</Link>
	</ItemDefinitionGroup>
</Project>